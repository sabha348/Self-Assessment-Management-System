# Copy to backend/.env and fill in. Never commit the real file.
PORT=8000
NODE_ENV=development

# MongoDB Atlas (or mongodb://localhost:27017/sams for local/docker)
MONGODB_URI=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Gemini (Google AI Studio)
GOOGLE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:3000
# Public URL of the frontend, used in password reset links and Stripe redirects
CLIENT_URL=http://localhost:3000

# Outgoing email (Gmail requires an App Password with 2FA)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
