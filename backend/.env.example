# Copy to backend/.env and fill in. Never commit the real file.
PORT=8000
NODE_ENV=development

# MongoDB Atlas (or mongodb://localhost:27017/sams for local/docker)
MONGODB_URI=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Gemini (Google AI Studio)
GOOGLE_API_KEY=
# Gemini model used for question generation, answers, grading and categorisation
GEMINI_MODEL=gemini-3.5-flash-lite

# Stripe
STRIPE_SECRET_KEY=

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:3000
# Public URL of the frontend, used in password reset links and Stripe redirects
CLIENT_URL=http://localhost:3000

# Outgoing email (Gmail requires an App Password with 2FA)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# First-admin bootstrap: these emails become admin on register/login, only while no admin exists yet
ADMIN_EMAILS=

# RAG service (rag_service/): grounded questions with page citations.
# Leave RAG_ENABLED=false until the service is deployed; the app then uses the legacy generator.
RAG_ENABLED=false
RAG_URL=http://localhost:8001
# Same value as SERVICE_TOKEN in the RAG service
RAG_SERVICE_TOKEN=
